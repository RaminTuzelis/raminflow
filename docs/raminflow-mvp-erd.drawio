          <mxGeometry x="1640" y="160" width="770" height="1090" as="geometry" />
        </mxCell>
        <mxCell id="future-header" value="PLANNED GROWTH - NOT CURRENT TABLES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#854d0e;strokeColor=#854d0e;fontColor=#ffffff;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1640" y="160" width="770" height="52" as="geometry" />
        </mxCell>

        <mxCell id="schema-growth-note" value="NEXT SCHEMA INCREMENTS&lt;br&gt;&lt;br&gt;1. changed_by_user_id on order_status_history&lt;br&gt;2. audit events with actor, time, entity, and before/after values&lt;br&gt;3. order_attachments metadata with protected external storage references&lt;br&gt;4. material stock movements rather than one mutable balance&lt;br&gt;&lt;br&gt;Each increment requires a concrete workflow and migration before it becomes part of the implemented ERD." style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;fillColor=#fff7d6;strokeColor=#d6b656;fontColor=#111827;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1685" y="255" width="680" height="285" as="geometry" />
        </mxCell>

        <mxCell id="spreadsheet-note" value="SPREADSHEET-ASSISTED ORDER DRAFT&lt;br&gt;&lt;br&gt;- Read supported .xlsx rows into the existing client-side item draft&lt;br&gt;- Detect headers, normalize values, and show row-level preview errors&lt;br&gt;- Ignore prices, formulas, and formatted blank rows&lt;br&gt;- Validate all confirmed items again in the existing Server Action&lt;br&gt;- Do not retain the source workbook or add an import table in the first version&lt;br&gt;&lt;br&gt;This is a workflow extension, not a current database entity." style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;fillColor=#eff6ff;strokeColor=#6c8ebf;fontColor=#111827;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1685" y="580" width="680" height="285" as="geometry" />
        </mxCell>

        <mxCell id="diagram-roadmap-note" value="LIVING DIAGRAM SET&lt;br&gt;&lt;br&gt;- ERD: tables, fields, keys, and cardinalities&lt;br&gt;- Use Case: role capabilities and system boundaries&lt;br&gt;- Activity: manual and spreadsheet-assisted order creation&lt;br&gt;- Domain/Class: stable business concepts and responsibilities&lt;br&gt;- Deployment: approved infrastructure when a real pilot exists&lt;br&gt;&lt;br&gt;Keep each diagram focused. src/db/schema.ts remains the source of truth for implemented database structure." style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;fillColor=#faf5ff;strokeColor=#9673a6;fontColor=#111827;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1685" y="905" width="680" height="285" as="geometry" />
        </mxCell>

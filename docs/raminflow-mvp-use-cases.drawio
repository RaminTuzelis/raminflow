        <mxCell id="role-mapping" value="ROLE MAPPING&lt;br&gt;&lt;br&gt;&lt;b&gt;Authenticated User&lt;/b&gt;&lt;br&gt;ADMIN, ADMINISTRATION, PRODUCTION_MANAGER, WORKER&lt;br&gt;&lt;br&gt;&lt;b&gt;Order Manager&lt;/b&gt;&lt;br&gt;ADMIN, ADMINISTRATION, PRODUCTION_MANAGER&lt;br&gt;&lt;br&gt;&lt;b&gt;User Administrator&lt;/b&gt;&lt;br&gt;ADMIN only&lt;br&gt;&lt;br&gt;Capability actors reduce repeated association lines. They are UML abstractions, not additional user_role values." style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#111827;spacing=15;" vertex="1" parent="1">

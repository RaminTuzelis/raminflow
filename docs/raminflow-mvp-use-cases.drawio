        </mxCell>
        <mxCell id="security-note" value="AUTHORIZATION RULE&lt;br&gt;&lt;br&gt;Visible UI actions improve usability, but protected pages and Server Actions repeat permission checks using the current database-backed user.&lt;br&gt;&lt;br&gt;Source of truth: src/lib/permissions.ts and protected route/action code." style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#111827;spacing=15;" vertex="1" parent="1">
